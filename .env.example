# ============================================================================
# CITIZEN SERVICES POINT (CITIZEN INDIA) — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# SECURITY RULE:
# - NEVER place real Secret Keys inside this file, frontend `/src/` files, or `dist/`.
# - Set real values exclusively in Netlify Dashboard -> Site Configuration -> Environment Variables.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. MANDATORY PRODUCTION ENVIRONMENT VARIABLES (SERVER & FRONTEND)
# ----------------------------------------------------------------------------

# VITE_RECAPTCHA_SITE_KEY: Public Google reCAPTCHA v3 Site Key used by the frontend.
VITE_RECAPTCHA_SITE_KEY="6LcZxwsuAAAAAAfSer968O7pBhQzWmRhtQ4sX-DO"

# RECAPTCHA_SECRET_KEY: Server-side Google reCAPTCHA v3 Secret Key (ROTATE IN ADMIN CONSOLE BEFORE PROD).
# CRITICAL: Must NEVER have a VITE_ prefix or be exposed in frontend code.
RECAPTCHA_SECRET_KEY="CHANGE_ME_ROTATED_SERVER_SIDE_RECAPTCHA_SECRET_KEY"

# CAPTCHA_SECRET_KEY: Permanent 64-character hex server-side secret key used to sign and verify
# stateless HMAC-SHA256 CAPTCHA tokens identically across all Netlify Serverless Function instances.
CAPTCHA_SECRET_KEY="CHANGE_ME_PERMANENT_64_CHAR_HEX_CAPTCHA_SECRET"

# APPS_SCRIPT_PLEDGE_URL: Server-side Google Apps Script Web App URL for the Citizen Pledge Card database.
APPS_SCRIPT_PLEDGE_URL=""

# APPS_SCRIPT_STATUS_URL: Server-side Google Apps Script Web App URL for the Application Status lookup database.
APPS_SCRIPT_STATUS_URL=""

# ----------------------------------------------------------------------------
# 2. RECOMMENDED / OPTIONAL SECURITY & RUNTIME ENVIRONMENT VARIABLES
# ----------------------------------------------------------------------------

# RECAPTCHA_ENFORCE_STRICT: Set to "true" in production so all requests strictly require live Google siteverify.
RECAPTCHA_ENFORCE_STRICT="false"

# RECAPTCHA_MIN_SCORE: Minimum human risk score threshold (0.0 to 1.0, default 0.5) for Google reCAPTCHA v3.
RECAPTCHA_MIN_SCORE="0.5"

# RECAPTCHA_MAX_AGE_SECONDS: Maximum allowed token age in seconds (default 120 seconds) from Google challenge_ts.
RECAPTCHA_MAX_AGE_SECONDS="120"

# RECAPTCHA_ALLOWED_HOSTNAMES: Comma-separated exact allowlist of authorized hostnames for reCAPTCHA v3 verification (no wildcards).
RECAPTCHA_ALLOWED_HOSTNAMES="citizenservicespoint.co.in,www.citizenservicespoint.co.in,ais-dev-ccywbxilblmquxnss3dg3s-690441376638.asia-southeast1.run.app,ais-pre-ccywbxilblmquxnss3dg3s-690441376638.asia-southeast1.run.app,localhost,127.0.0.1"

# APPS_SCRIPT_SHARED_SECRET: Shared HMAC secret stored in both Netlify Environment Variables
# and Status Google Apps Script Script Properties to authenticate server-to-Apps-Script requests.
APPS_SCRIPT_SHARED_SECRET="CHANGE_ME_SERVER_SIDE_APPS_SCRIPT_SHARED_SECRET"

# APPS_SCRIPT_PLEDGE_SECRET: Shared HMAC secret stored in both Netlify Environment Variables
# and Pledge Card Google Apps Script Script Properties to authenticate server-to-Apps-Script requests.
APPS_SCRIPT_PLEDGE_SECRET="CHANGE_ME_SERVER_SIDE_PLEDGE_SECRET"

# APPS_SCRIPT_ENFORCE_STRICT_POST: Set to "true" only if the Status Google Apps Script implements doPost(e).
APPS_SCRIPT_ENFORCE_STRICT_POST="false"

# FORMSUBMIT_AJAX_URL: Server-side dispatch endpoint for Customer Service Request notifications.
FORMSUBMIT_AJAX_URL=""

# GEMINI_API_KEY: Optional server-side key for `/api/civic-translate` multilingual translation helper.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

